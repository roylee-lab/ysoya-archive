# PythonAnywhere 용 .env 예시
# 프로젝트 폴더(~/ysoya-archive-flask)에 .env 라는 이름으로 복사한 뒤 값을 바꾸세요:
#   cp deploy/env.pythonanywhere.example .env && nano .env
# .env 는 GitHub 에 올라가지 않습니다 (.gitignore 에 들어 있음).

# 로그인 유지용 비밀 값. 콘솔에서 python3 -c "import secrets; print(secrets.token_hex(32))" 로 만든 값을 붙여 넣기
SECRET_KEY=여기에-64글자

# PythonAnywhere 는 HTTPS 주소를 주므로 1
COOKIE_SECURE=1

# 공용 비밀번호로 잠글 때만. 회원 전용 모드(site_config.local.json 의 members_only)를 쓰면 비워 두기
SITE_PASSWORD=

# PythonAnywhere 의 저장소에서는 SQLite 를 이 방식으로 쓰는 편이 안전
SQLITE_JOURNAL=DELETE
